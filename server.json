{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "in.hookstep/hookpost",
  "title": "Hookpost",
  "description": "Draft and schedule social media posts on your connected channels from Claude or any MCP client.",
  "version": "1.0.1",
  "websiteUrl": "https://hookpost.hookstep.in/mcp",
  "repository": {
    "url": "https://github.com/jatinder14/hookpost-mcp",
    "source": "github"
  },
  "icons": [
    {
      "src": "https://hookpost.hookstep.in/brand-logo.png",
      "mimeType": "image/png",
      "sizes": [
        "512x512"
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://hookpost.hookstep.in/api/mcp",
      "headers": [
        {
          "name": "Authorization",
          "description": "Your Hookpost workspace API key, from Settings > Developers in Hookpost (Standard or Pro plan, 3-day trial included).",
          "isRequired": true,
          "isSecret": true,
          "value": "Bearer {api_key}",
          "variables": {
            "api_key": {
              "description": "Hookpost workspace API key (Settings > Developers)",
              "isRequired": true,
              "isSecret": true
            }
          }
        }
      ]
    }
  ]
}
