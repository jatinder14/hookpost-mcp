{
  "name": "n8n-nodes-hookpost",
  "version": "0.1.1",
  "description": "n8n community node for Hookpost - schedule and publish social media posts across social networks",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "hookpost",
    "social media",
    "scheduling"
  ],
  "license": "UNLICENSED",
  "author": "Hookstep",
  "homepage": "https://hookpost.hookstep.in/docs/public-api",
  "main": "index.js",
  "scripts": {
    "build": "tsc && node copy-assets.js",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/HookpostApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Hookpost/Hookpost.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "n8n-workflow": "^1.82.0",
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
