{
  "name": "n8n-nodes-hookpost",
  "version": "0.2.0",
  "description": "n8n community node for Hookpost: schedule, publish and draft social media posts across your connected channels",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "hookpost",
    "social media",
    "scheduling"
  ],
  "license": "MIT",
  "author": {
    "name": "Hookstep",
    "email": "support@hookstep.in"
  },
  "homepage": "https://github.com/jatinder14/hookpost-mcp/tree/main/n8n-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jatinder14/hookpost-mcp.git",
    "directory": "n8n-node"
  },
  "bugs": {
    "url": "https://github.com/jatinder14/hookpost-mcp/issues"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/HookpostApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Hookpost/Hookpost.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "^0.54.3",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
